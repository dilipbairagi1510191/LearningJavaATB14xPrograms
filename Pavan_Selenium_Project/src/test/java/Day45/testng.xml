<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "http://testng.org/testng-1.0.dtd">

<suite name="All Test Suite" parallel="tests">

    <!-- Chrome Test -->
    <test name="ChromeTest" verbose="2" preserve-order="true">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="Day45.ParamTest">
                <methods>
                    <include name="testLogo"/>
                    <include name="getTitle"/>
                    <include name="testUrl"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Edge Test -->
    <test name="EdgeTest" verbose="2" preserve-order="true">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="Day45.ParamTest">
                <methods>
                    <include name="testLogo"/>
                    <include name="getTitle"/>
                    <include name="testUrl"/>
                </methods>
            </class>
        </classes>
    </test>

    <!-- Edge Test -->
    <test name="FirefoxTest" verbose="2" preserve-order="true">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="Day45.ParamTest">
                <methods>
                    <include name="testLogo"/>
                    <include name="getTitle"/>
                    <include name="testUrl"/>
                </methods>
            </class>
        </classes>
    </test>



</suite>
